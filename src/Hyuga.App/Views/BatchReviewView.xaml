<UserControl x:Class="Hyuga.App.Views.BatchReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Revision por lote" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Completa los datos y revisa el resultado de cada pagina." Foreground="{StaticResource TextMutedBrush}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="12">
                <ListView ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Pg" DisplayMemberBinding="{Binding PageIndex}" Width="40" />
                            <GridViewColumn Header="Pub" DisplayMemberBinding="{Binding PublicationId}" Width="70" />
                            <GridViewColumn Header="Pag" DisplayMemberBinding="{Binding PageNumber}" Width="60" />
                            <GridViewColumn Header="Sec" DisplayMemberBinding="{Binding Section}" Width="60" />
                            <GridViewColumn Header="Fecha" DisplayMemberBinding="{Binding Date}" Width="120" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <StackPanel Grid.Column="2">
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Vista previa" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="8" Height="220">
                            <Viewbox>
                                <TextBlock Text="Vista previa de pagina" Foreground="{StaticResource TextMutedBrush}" />
                            </Viewbox>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Metadatos" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <TextBlock Text="Publicacion" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                        <ComboBox Height="34" Margin="0,4,0,8" />

                        <TextBlock Text="Pagina" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedPage.PageNumber}" Margin="0,4,0,8" />

                        <TextBlock Text="Seccion" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedPage.Section}" Margin="0,4,0,8" />

                        <TextBlock Text="Fecha" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedPage.Date}" Margin="0,4,0,8" />

                        <Button Content="Aplicar publicacion a todo" Command="{Binding ApplyPublicationCommand}" Background="{StaticResource SurfaceBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" Margin="0,6,0,0" />
                        <Button Content="Copiar ultima publicacion" Command="{Binding CopyLastPublicationCommand}" Background="{StaticResource SurfaceBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" Margin="0,6,0,0" />
                        <Button Content="Reusar ultima fecha" Command="{Binding ReuseLastDateCommand}" Background="{StaticResource SurfaceBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" Margin="0,6,0,0" />
                        <Button Content="Marcar como completo" Command="{Binding MarkDoneCommand}" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="Volver" Command="{Binding BackCommand}" Background="{StaticResource SurfaceBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" Margin="0,0,12,0" />
                    <Button Content="Generar PDF" Command="{Binding GenerateCommand}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
