<Application x:Class="Hyuga.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Hyuga.App.Views"
             xmlns:vm="clr-namespace:Hyuga.App.ViewModels">
    <Application.Resources>
        <FontFamily x:Key="PrimaryFontFamily">Bahnschrift</FontFamily>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F1D1A" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#6B6661" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFDF7" />
        <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#F0ECE5" />
        <SolidColorBrush x:Key="AccentBrush" Color="#D87A3B" />
        <SolidColorBrush x:Key="AccentStrongBrush" Color="#B85F27" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D2C8BD" />

        <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F7F1E8" Offset="0" />
            <GradientStop Color="#F2E6D5" Offset="0.6" />
            <GradientStop Color="#F7F4EF" Offset="1" />
        </LinearGradientBrush>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
        </Style>

        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImportViewModel}">
            <views:ImportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BatchReviewViewModel}">
            <views:BatchReviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GenerateViewModel}">
            <views:GenerateView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExportViewModel}">
            <views:ExportView />
        </DataTemplate>
    </Application.Resources>
</Application>
